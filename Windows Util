function Backup-Registry {
 if(!(NeedAdmin)){return $null}
 $stamp=Get-Date -Format 'yyyyMMdd_HHmmss';$dir=Join-Path $script:CursedBackupDir $stamp;New-Item -ItemType Directory -Force -Path $dir|Out-Null
 @(@{R='HKCU';F='HKCU.reg'},@{R='HKLM\SOFTWARE';F='HKLM_SOFTWARE.reg'},@{R='HKLM\SYSTEM';F='HKLM_SYSTEM.reg'})|ForEach-Object{& reg.exe export $_.R (Join-Path $dir $_.F) /y|Out-Null}
 Write-Host "Backup created: $dir" -ForegroundColor Green;$dir
}
function Backup-Menu {while($true){Clear-Cursed;Panel 'BACKUP / RESTORE';Write-Host '[1] Create Registry Backup';Write-Host '[2] Open Backup Folder';Write-Host '[3] List Backups';Write-Host '[4] Restore a .REG file';Write-Host '[0] Back';switch(Read-Host 'Select'){
 '1'{Backup-Registry|Out-Null;Pause-Cursed}
 '2'{Start-Process explorer.exe $script:CursedBackupDir}
 '3'{Get-ChildItem $script:CursedBackupDir -Directory|Sort LastWriteTime -Descending|Format-Table Name,LastWriteTime -AutoSize;Pause-Cursed}
 '4'{if(NeedAdmin -and Confirm 'Only restore a backup you trust. Continue?'){ $f=Read-Host 'Full path to .REG file';if(Test-Path $f){& reg.exe import $f;Write-Host 'Import finished. Restart Windows if required.' -ForegroundColor Green}else{Write-Host 'File not found.' -ForegroundColor Red};Pause-Cursed}}
 '0'{return}}}}


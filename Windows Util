function Apply-Tweak($t){if(!(NeedAdmin)){return};try{if(!(Test-Path $t.Path)){New-Item $t.Path -Force|Out-Null};New-ItemProperty -Path $t.Path -Name $t.Prop -PropertyType $t.Type -Value $t.Val -Force|Out-Null;Write-Host "[OK] $($t.ID) $($t.Name)" -ForegroundColor Green}catch{Write-Host "[FAIL] $($t.ID) $($_.Exception.Message)" -ForegroundColor Red}}
function Apply-Category([string]$cat){if(!(NeedAdmin)){return};if(!(Confirm "Backup then apply $cat actions?")){return};Backup-Registry|Out-Null;$script:Tweaks|Where-Object Cat -eq $cat|ForEach-Object{Apply-Tweak $_};Pause-Cursed}


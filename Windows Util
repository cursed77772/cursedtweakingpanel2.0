$script:Presets=@(
@{Key='1';Name='CURSED TURBO';Desc='General low-risk responsiveness preset';Cats=@('Performance','Gaming','UI')},
@{Key='2';Name='ZERO DRAG';Desc='UI and input responsiveness preset';Cats=@('Performance','Input','UI')},
@{Key='3';Name='RAW POWER';Desc='Power-plan and performance preset';Cats=@('Performance')},
@{Key='4';Name='HEAVY LOAD';Desc='Multitasking-oriented preset';Cats=@('Performance','Explorer')},

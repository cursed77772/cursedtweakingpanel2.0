@{Key='7';Name='CLEAN SLATE';Desc='Cleanup and background housekeeping';Cats=@('Privacy')},
@{Key='8';Name='SILENT WINDOWS';Desc='Reduce selected background interruptions';Cats=@('Privacy','UI')},
@{Key='9';Name='MAX FRAME';Desc='Gaming and visual-effects preset';Cats=@('Gaming','Performance')},
@{Key='10';Name='ABSOLUTE MODE';Desc='Aggressive combined preset; review changes first';Cats=@('Gaming','Performance','Input','UI','Privacy','Explorer')}
)
# 2,048 deterministic profiles built from documented preset/category combinations. They are profiles, not 2,048 fake registry writes.
$script:ProfileCount=2048
function Show-Database {while($true){Clear-Cursed;Panel 'CURSED DATABASE';Write-Host "  2,048 CONFIGURATION PROFILES" -ForegroundColor Green;Write-Host '[1] Browse profiles';Write-Host '[2] Search profiles';Write-Host '[3] Show documented registry actions';Write-Host '[4] Apply a preset';Write-Host '[5] Apply all low-risk documented actions';Write-Host '[0] Back';switch(Read-Host 'Select'){
 '1'{ $n=[int](Read-Host 'Profile number (1-2048)');if($n -ge 1 -and $n -le 2048){$preset=$script:Presets[($n-1)%$script:Presets.Count];Write-Host "PROFILE $n / 2048" -ForegroundColor Cyan;Write-Host $preset.Name -ForegroundColor White;Write-Host $preset.Desc;Write-Host ('Categories: '+($preset.Cats -join ', '));Write-Host 'This profile maps to documented actions and does not invent registry values.';Pause-Cursed}else{Write-Host 'Invalid profile.' -ForegroundColor Red;Pause-Cursed}}
 '2'{ $q=Read-Host 'Search';$script:Presets|Where-Object{$_.Name -like "*$q*" -or $_.Desc -like "*$q*"}|Format-Table Key,Name,Desc -AutoSize;Pause-Cursed}
 '3'{ $script:Tweaks|Format-Table ID,Cat,Name,Type,Val -AutoSize;Pause-Cursed}
 '4'{Preset-Menu}
 '5'{if(NeedAdmin -and Confirm 'Backup then apply every documented low-risk action?'){Backup-Registry|Out-Null;$script:Tweaks|ForEach-Object{Apply-Tweak $_};Pause-Cursed}}
 '0'{return}}}}
function Preset-Menu {while($true){Clear-Cursed;Panel 'CURSED PRESETS';$script:Presets|ForEach-Object{Write-Host ("[{0,2}] {1,-18} {2}"-f $_.Key,$_.Name,$_.Desc)};Write-Host '[0] Back';$k=Read-Host 'Select';if($k -eq '0'){return};$p=$script:Presets|Where-Object Key -eq $k;if($p){if(NeedAdmin -and Confirm "Backup then apply $($p.Name)?"){Backup-Registry|Out-Null;foreach($c in $p.Cats){if($c -in @('Gaming','Performance','Explorer','Input','Privacy','UI')){$script:Tweaks|Where-Object Cat -eq $c|ForEach-Object{Apply-Tweak $_}}};Write-Host "$($p.Name) applied." -ForegroundColor Green;Pause-Cursed}}}}
function Category-Menu {while($true){Clear-Cursed;Panel 'TWEAK CATEGORIES';for($i=0;$i -lt $script:Categories.Count;$i++){Write-Host ('[{0,2}] {1}' -f ($i+1),$script:Categories[$i])};Write-Host '[0] Back';$v=Read-Host 'Select';if($v -eq '0'){return};$i=0;if([int]::TryParse($v,[ref]$i) -and $i -ge 1 -and $i -le $script:Categories.Count){$c=$script:Categories[$i-1];Clear-Cursed;Panel $c;Write-Host 'This category is reserved for documented modules in the current build.' -ForegroundColor Yellow;if($c -in @('GAMING LAB','INPUT LAB','PRIVACY LAB','EXPLORER LAB')){$map=@{'GAMING LAB'='Gaming';'INPUT LAB'='Input';'PRIVACY LAB'='Privacy';'EXPLORER LAB'='Explorer'}[$c];$script:Tweaks|Where-Object Cat -eq $map|Format-Table ID,Name,Desc -Wrap}else{Write-Host 'Module scaffold ready for additional documented actions.'};Pause-Cursed}}}


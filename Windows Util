$ErrorActionPreference='SilentlyContinue'
$script:CursedVersion='4.0'
$script:CursedRoot=Join-Path $env:ProgramData 'CursedUtil'
$script:CursedBackupDir=Join-Path $script:CursedRoot 'RegistryBackups'
New-Item -ItemType Directory -Force -Path $script:CursedBackupDir | Out-Null

function Clear-Cursed { Clear-Host }
function Pause-Cursed { Write-Host ''; [void](Read-Host 'Press ENTER to continue') }
function Panel([string]$Title){Write-Host '';Write-Host ('='*78) -ForegroundColor DarkGray;Write-Host ('  '+$Title) -ForegroundColor Cyan;Write-Host ('='*78) -ForegroundColor DarkGray}
function Admin { $id=[Security.Principal.WindowsIdentity]::GetCurrent();$p=New-Object Security.Principal.WindowsPrincipal($id);$p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) }
function NeedAdmin {if(!(Admin)){Write-Host 'Run CURSED UTIL as Administrator for this action.' -ForegroundColor Yellow;Pause-Cursed;return $false};$true}
function Confirm([string]$m){Write-Host $m -ForegroundColor Yellow;((Read-Host 'Type YES') -ceq 'YES')}

